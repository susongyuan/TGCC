{
  "schema": "tgcc.success_distribution.recipe.v1",
  "seed": 42,
  "new_updates": 6000,
  "critic_warmup_updates": 1000,
  "joint_updates": 5000,
  "effective_batch": 48,
  "max_gpus": 4,
  "critic_lr": 0.0001,
  "retrieval_adapter_lr": 0.000002,
  "action_expert_lr": 0.000002,
  "weight_decay": 0.01,
  "betas": [0.9, 0.95],
  "warmup": 100,
  "min_lr_ratio": 0.1,
  "grad_clip": 1.0,
  "checkpoint_every": 250,
  "keep_last_checkpoints": 2,
  "action_mixtures": 4,
  "execution_mixtures": 2,
  "minimum_scale": 0.05,
  "maximum_scale": 5.0,
  "hidden": 256,
  "loss_weights": {"action": 1.0, "execution": 1.0, "planning": 0.2, "flow": 1.0},
  "calibration_alpha": 0.1,
  "calibration_minimum_episodes": 16,
  "encoder_frozen": true,
  "vision_vlm_graphs_frozen": true,
  "action_expert_trainable": true,
  "negative_examples_used": false,
  "failure_classifier_trained": false,
  "retrieval_excludes_query_episode": true,
  "retrieval_conditioning_dropout": 0.25,
  "interpretation": "success-demonstration distribution normality; OOD is not a verified failure",
  "formal_training_requires_current_source_data_and_gpu_readiness": true
}
